# Copy this file to .env and fill in your values

# Free token from https://reverb.com/my/api_settings — used to estimate market value
REVERB_API_TOKEN=

# Your local craigslist site: the first part of the URL when you visit craigslist
# (e.g. "savannah" for savannah.craigslist.org). If empty, it's derived from
# your default search location.
CRAIGSLIST_SITE=

# Cloud publishing: where the app pushes findings so the phone site works away
# from home. WITHOUT THESE the phone view silently stops updating.
PUBLISH_URL=
PUBLISH_KEY=

# eBay Developers Program production keyset (enables API-based eBay access)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
