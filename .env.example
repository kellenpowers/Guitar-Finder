# Copy this file to .env and fill in your values

# Free token from https://reverb.com/my/api_settings — used to estimate market value
REVERB_API_TOKEN=

# Your local craigslist site: the first part of the URL when you visit craigslist
# (e.g. "austin" for austin.craigslist.org). Leave empty to skip Craigslist.
CRAIGSLIST_SITE=
