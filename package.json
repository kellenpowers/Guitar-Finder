{
  "name": "marketplace-deal-finder",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "setup": "npm install && npm run build --workspace=client && npm run typecheck && npx playwright install chromium",
    "start": "npm run start --workspace=server",
    "test": "npm run test --workspace=server",
    "typecheck": "npm run typecheck --workspace=server",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=client"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.7.0"
  }
}
